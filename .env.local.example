# Frontend environment variables for local development.
# Copy this to .env.local for local dev, or set these in Vercel dashboard for production.
# NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# ─── Clerk (frontend-facing) ──────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=YOUR_VERCEL_APP_URL
