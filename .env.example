# SecondBrain — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.

# ── MongoDB ──────────────────────────────────────────────
# Local dev: mongodb://localhost:27017
# Production: Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=

# Database name (can leave as-is)
DB_NAME=ai_second_brain

# ── Clerk Authentication ───────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs (required for sign-in/sign-up flow)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── App ────────────────────────────────────────────────────
# Production: set to your domain, e.g. https://yourdomain.com
# (also used for CORS and SEO/OpenGraph metadata)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
